<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GSM3.Pages.InstancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GSM3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock
            Grid.Row="0"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="实例管理" />

        <!-- Status InfoBar -->
        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            IsOpen="False" />

        <!-- Toolbar -->
        <CommandBar
            Grid.Row="2"
            HorizontalAlignment="Left"
            DefaultLabelPosition="Right"
            IsOpen="False">
            <AppBarButton
                x:Name="CreateInstanceButton"
                Click="CreateInstanceButton_Click"
                Label="创建实例">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE710;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="StartButton"
                Click="StartButton_Click"
                Label="启动">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="StopButton"
                Click="StopButton_Click"
                Label="停止">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71A;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="RestartButton"
                Click="RestartButton_Click"
                Label="重启">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72C;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="DeleteButton"
                Click="DeleteButton_Click"
                Label="删除">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <!-- Instance List -->
        <Border
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ListView
                x:Name="InstanceListView"
                Padding="4"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Padding="12,8"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Status Indicator -->
                            <Ellipse
                                Grid.Column="0"
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Fill="Gray" />

                            <!-- Instance Name -->
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />

                            <!-- Instance Type -->
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding GameType}"
                                TextTrimming="CharacterEllipsis" />

                            <!-- Working Directory -->
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding WorkingDirectory}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Create Instance Dialog -->
        <ContentDialog
            x:Name="CreateInstanceDialog"
            Title="创建实例"
            CloseButtonText="取消"
            DefaultButton="Primary"
            PrimaryButtonText="创建">
            <StackPanel
                MinWidth="400"
                Spacing="16">
                <TextBox
                    x:Name="InstanceNameTextBox"
                    Header="名称"
                    PlaceholderText="输入实例名称" />
                <ComboBox
                    x:Name="GameTypeComboBox"
                    Header="游戏类型"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="选择游戏类型">
                    <ComboBoxItem Content="Minecraft" />
                    <ComboBoxItem Content="CS2" />
                    <ComboBoxItem Content="Valheim" />
                    <ComboBoxItem Content="ARK" />
                </ComboBox>
                <TextBox
                    x:Name="WorkingDirectoryTextBox"
                    Header="工作目录"
                    PlaceholderText="输入工作目录路径" />
                <TextBox
                    x:Name="ExecutablePathTextBox"
                    Header="可执行文件路径"
                    PlaceholderText="输入可执行文件路径" />
                <TextBox
                    x:Name="LaunchArgumentsTextBox"
                    Header="启动参数"
                    PlaceholderText="输入启动参数" />
                <NumberBox
                    x:Name="PortNumberBox"
                    Header="端口"
                    Minimum="1"
                    Maximum="65535"
                    SpinButtonPlacementMode="Compact"
                    Value="25565" />
                <NumberBox
                    x:Name="RconPortNumberBox"
                    Header="RCON 端口"
                    Minimum="1"
                    Maximum="65535"
                    SpinButtonPlacementMode="Compact"
                    Value="25575" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
