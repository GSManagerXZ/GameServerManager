<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GSM3.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GSM3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- 常规设置 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="常规设置" />

                        <ComboBox
                            x:Name="ThemeComboBox"
                            Header="主题"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" IsSelected="True" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>

                        <ComboBox
                            x:Name="LanguageComboBox"
                            Header="语言"
                            HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="简体中文" IsSelected="True" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>

                        <ToggleSwitch
                            x:Name="AutoStartInstancesToggle"
                            Header="启动时自动运行实例" />

                        <ToggleSwitch
                            x:Name="MinimizeToTrayToggle"
                            Header="最小化到系统托盘" />
                    </StackPanel>
                </Border>

                <!-- 终端设置 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="终端设置" />

                        <ComboBox
                            x:Name="DefaultShellComboBox"
                            Header="默认终端"
                            HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="PowerShell" IsSelected="True" />
                            <ComboBoxItem Content="CMD" />
                            <ComboBoxItem Content="Bash" />
                        </ComboBox>

                        <NumberBox
                            x:Name="MaxSessionsNumberBox"
                            Header="最大会话数"
                            Minimum="1"
                            Maximum="20"
                            Value="5"
                            SpinButtonPlacementMode="Inline" />
                    </StackPanel>
                </Border>

                <!-- 安全设置 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="安全设置" />

                        <NumberBox
                            x:Name="MaxLoginAttemptsNumberBox"
                            Header="最大登录尝试次数"
                            Value="5"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline" />

                        <NumberBox
                            x:Name="LockoutMinutesNumberBox"
                            Header="锁定时长(分钟)"
                            Value="15"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline" />
                    </StackPanel>
                </Border>

                <!-- 路径配置 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="路径配置" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="SteamCMD 路径" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SteamCmdPathTextBox" PlaceholderText="选择 SteamCMD 路径..." />
                                <Button
                                    Grid.Column="1"
                                    Click="BrowseSteamCmdPath_Click"
                                    Content="&#xE8DA;"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="游戏安装路径" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GameInstallPathTextBox" PlaceholderText="选择游戏安装路径..." />
                                <Button
                                    Grid.Column="1"
                                    Click="BrowseGameInstallPath_Click"
                                    Content="&#xE8DA;"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="关于" />
                        <TextBlock Text="GSM3 游戏服务器管理面板" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="版本 1.0.0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
