<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GSM3.Pages.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GSM3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and session management toolbar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="终端" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4">
                <Button x:Name="NewSessionButton" Click="NewSessionButton_Click" ToolTipService.ToolTip="新建会话">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="新建会话" />
                    </StackPanel>
                </Button>
                <Button x:Name="CloseSessionButton" Click="CloseSessionButton_Click" ToolTipService.ToolTip="关闭会话">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                        <TextBlock Text="关闭会话" />
                    </StackPanel>
                </Button>
                <Button x:Name="ClearScreenButton" Click="ClearScreenButton_Click" ToolTipService.ToolTip="清屏">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="清屏" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Session tabs -->
        <StackPanel
            x:Name="SessionTabs"
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="4">
            <Button
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Content="会话 1"
                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Button Content="会话 2" />
            <Button ToolTipService.ToolTip="新建会话">
                <FontIcon FontSize="12" Glyph="&#xE710;" />
            </Button>
        </StackPanel>

        <!-- Terminal output area -->
        <Border
            Grid.Row="3"
            Background="#0C0C0C"
            CornerRadius="8">
            <ScrollViewer
                x:Name="TerminalScrollViewer"
                Padding="12"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="TerminalOutput"
                    FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                    FontSize="14"
                    Foreground="#CCCCCC"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <!-- Command input area -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="CommandInput"
                Grid.Column="0"
                FontFamily="Cascadia Mono, Consolas, monospace"
                KeyDown="CommandInput_KeyDown"
                PlaceholderText="输入命令..." />

            <Button
                x:Name="SendButton"
                Grid.Column="1"
                Click="SendButton_Click"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="发送">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE724;" />
                    <TextBlock Text="发送" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
